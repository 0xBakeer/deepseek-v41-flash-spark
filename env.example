# ---------------------------------------------------------------------------
# DeepSeek-V4.1-Flash on a single NVIDIA DGX Spark (GB10 / sm_121, 121 GiB unified)
# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value here is also overridable from the
# environment, so `PORT=8001 ./start.sh` works without touching the file.
#
# The same file configures both ways of running the recipe: ./start.sh (a plain
# Python process in a venv on the box) and ./run.sh / docker compose (the
# container). docs/install.md compares them.

# --- what to serve -------------------------------------------------------
# The full 510 GB checkpoint: 48 safetensors shards, `inference/`, `encoding/`
# and the tokenizer. Experts are streamed from here at run time, so this path
# must be on local NVMe -- not NFS, not overlayfs (O_DIRECT will not work).
# ./run.sh derives the container's bind mount from this (MODELS_DIR = its
# parent, MODEL_NAME = its basename).
MODEL_DIR=./models/DeepSeek-V4.1-Flash

# The interpreter that has torch (CUDA 13 / sm_121), triton, transformers,
# safetensors, numpy and sympy -- see docs/install.md for building one. Used by
# ./start.sh only; the container brings its own. A bare name is looked up on
# PATH, so `python3` works if that is already the right interpreter; point it at
# a venv (e.g. .venv/bin/python) otherwise.
PYTHON=python3

SERVED_MODEL_NAME=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=8000

# --- engine shape --------------------------------------------------------
# KV cache + indexer slices are allocated for MAX_SEQ tokens up front, so this
# is a memory knob as much as a context knob. 32768 costs ~1 GB of the arena.
MAX_SEQ=32768

# GB of resident FP4 expert arena (each expert is 18.8 MB, 384 per layer x 40
# layers = 288.8 GB total, so this is the hot set and everything else is a
# NVMe read). Empty = size it automatically from free memory at load time,
# which is the right default; set it only to pin a layout for an A/B.
ARENA_GB=

# Which experts the warm start pulls in, ranked by a measured routing trace
# (tools/expert_stats.py output). Without it the warm start falls back to
# (layer, expert) index order, which is a measurably worse hot set.
# Leave it EMPTY for auto: both ./start.sh and the container entrypoint then
# take the newest results/trace-*/stats/coverage.json in the checkout. Set it
# to a path only to pin one particular trace.
TRACE_STATS=

# --- thinking ------------------------------------------------------------
# V4.1's template is not binary: thinking on/off plus an effort budget 1-100
# rendered as a `Reasoning Effort: N` system prefix. These are the defaults for
# requests that say nothing; any request can override them (server/README.md).
DEFAULT_THINKING=off
DEFAULT_EFFORT=75

# --- speculative decoding ------------------------------------------------
# 1 = use the checkpoint's MTP/DSpark layers to draft (lossless, the target
# verifies every drafted token). 0 = plain autoregressive decode, the A/B
# baseline and the first thing to turn off when debugging numerics.
SPEC=1

# --- guards --------------------------------------------------------------
# MemAvailable the launcher demands before it will load (GiB). 0 disables.
MIN_FREE_GIB=90

# --- container only ------------------------------------------------------
# Registry namespace for the prebuilt image (ghcr.io/<owner>/deepseek-v41-flash-spark).
# GHCR_OWNER=0xbakeer
# Optional Hugging Face token for scripts/download-model.sh. The repo is public;
# a token only raises rate limits. Keep it in .env, never in env.example.
# HF_TOKEN=
