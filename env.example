# ---------------------------------------------------------------------------
# DeepSeek-V4.1-Flash on a single NVIDIA DGX Spark (GB10 / sm_121, 121 GiB unified)
# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value here is also overridable from the
# environment, so `PORT=8001 ./start.sh` works without touching the file.
#
# Unlike the ling3 recipe this is NOT a container and NOT an inference engine
# with its own launcher: ./start.sh runs `server/app.py --engine v41`, a plain
# Python process, in a venv that already has torch/transformers/safetensors.

# --- what to serve -------------------------------------------------------
# The full 510 GB checkpoint: 48 safetensors shards, `inference/`, `encoding/`
# and the tokenizer. Experts are streamed from here at run time, so this path
# must be on the NVMe, not on NFS.
MODEL_DIR="$HOME/models/DeepSeek-V4.1-Flash"

# The interpreter that has torch (CUDA 13 / sm_121), transformers, safetensors,
# numpy and sympy. There is no venv of our own: we borrow the ling3 recipe's,
# which is the only one on this box built against the right torch.
PYTHON="$HOME/recipes/ling3-flash-dgx-spark/.venv/bin/python"

SERVED_MODEL_NAME="deepseek-v4.1-flash"
HOST=127.0.0.1
PORT=8000

# --- engine shape --------------------------------------------------------
# KV cache + indexer slices are allocated for MAX_SEQ tokens up front, so this
# is a memory knob as much as a context knob. 32768 costs ~1 GB of the arena.
MAX_SEQ=32768

# GB of resident FP4 expert arena (each expert is 18.8 MB, 384 per layer x 40
# layers = 288.8 GB total, so this is the hot set and everything else is a
# NVMe read). Empty = size it automatically from free GPU memory at load time,
# which is the right default; set it only to pin a layout for an A/B.
ARENA_GB=

# Which experts the warm start pulls in, ranked by the measured routing trace
# (tools/expert_stats.py output). Without it the warm start falls back to
# (layer, expert) index order, which is a worse hot set than the trace's.
# start.sh falls back to results/trace-partial/stats/coverage.json if the
# full-trace file is not there yet.
TRACE_STATS=results/trace-full/stats/coverage.json

# --- thinking ------------------------------------------------------------
# V4.1's template is not binary: thinking on/off plus an effort budget 1-100
# rendered as a `Reasoning Effort: N` system prefix. These are the defaults for
# requests that say nothing; any request can override them (server/README.md).
DEFAULT_THINKING=off
DEFAULT_EFFORT=75

# --- speculative decoding ------------------------------------------------
# 1 = use the checkpoint's MTP layers to draft (lossless, the target verifies
# every drafted token). 0 = plain autoregressive decode, the A/B baseline and
# the first thing to turn off when debugging a numerics problem.
SPEC=1
