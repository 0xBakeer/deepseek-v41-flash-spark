# ---------------------------------------------------------------------------
# DeepSeek-V4.1-Flash on a single NVIDIA DGX Spark (GB10 / sm_121, 121 GiB unified)
# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value here is also overridable from the
# environment, so `PORT=8001 ./start.sh` works without touching the file.
#
# The same file configures both ways of running the recipe: ./start.sh (a plain
# Python process in a venv on the box) and ./run.sh / docker compose (the
# container). docs/install.md compares them.

# --- what to serve -------------------------------------------------------
# The full 510 GB checkpoint: 48 safetensors shards, `inference/`, `encoding/`
# and the tokenizer. Experts are streamed from here at run time, so this path
# must be on local NVMe -- not NFS, not overlayfs (O_DIRECT will not work).
# ./run.sh derives the container's bind mount from this (MODELS_DIR = its
# parent, MODEL_NAME = its basename).
MODEL_DIR=./models/DeepSeek-V4.1-Flash

# The interpreter that has torch (CUDA 13 / sm_121), triton, transformers,
# safetensors, numpy and sympy -- see docs/install.md for building one. Used by
# ./start.sh only; the container brings its own. A bare name is looked up on
# PATH, so `python3` works if that is already the right interpreter; point it at
# a venv (e.g. .venv/bin/python) otherwise.
PYTHON=python3

SERVED_MODEL_NAME=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=8000

# --- engine shape --------------------------------------------------------
# KV cache + indexer slices are allocated for MAX_SEQ tokens up front, so this
# is a memory knob as much as a context knob. 32768 costs ~1 GB of the arena.
MAX_SEQ=32768

# GB of resident FP4 expert arena (each expert is 18.8 MB, 384 per layer x 40
# layers = 288.8 GB total, so this is the hot set and everything else is a
# NVMe read). Empty = size it automatically from free memory at load time,
# which is the right default; set it only to pin a layout for an A/B.
ARENA_GB=

# Which experts the warm start pulls in, ranked by a measured routing trace
# (tools/expert_stats.py output). Without it the warm start falls back to
# (layer, expert) index order, which is a measurably worse hot set.
# Leave it EMPTY for auto: both ./start.sh and the container entrypoint then
# take the newest results/trace-*/stats/coverage.json in the checkout. Set it
# to a path only to pin one particular trace.
TRACE_STATS=

# --- thinking ------------------------------------------------------------
# V4.1's template is not binary: thinking on/off plus an effort budget 1-100
# rendered as a `Reasoning Effort: N` system prefix. These are the defaults for
# requests that say nothing; any request can override them (server/README.md).
DEFAULT_THINKING=off
DEFAULT_EFFORT=75

# --- tool calling --------------------------------------------------------
# 1 = constrain decoding to the DSML tool-calls block with a grammar built from
# the request's own tool schemas (server/tool_grammar.py, needs xgrammar). The
# constraint starts when the model writes the calls marker and ends when the
# block closes, after which only the end-of-turn token is legal -- which is what
# keeps a drifting tool call from running to the output cap. Prose is never
# constrained and a request without tools never builds a grammar. 0 = sample
# freely and recover malformed calls with the tolerant parser in server/app.py.
# DSV41_TOOL_GRAMMAR=1   (default 0 until the end-to-end gates have run)
# Log the generated grammar (and the grammar that failed to compile, if any).
# DSV41_LOG_TOOL_GRAMMAR=0
# Log the raw text of a tool call the strict parser rejected.
# DSV41_LOG_TOOL_TEXT=0

# --- speculative decoding ------------------------------------------------
# 1 = use the checkpoint's MTP/DSpark layers to draft (lossless, the target
# verifies every drafted token). 0 = plain autoregressive decode, the A/B
# baseline and the first thing to turn off when debugging numerics.
SPEC=1

# --- guards --------------------------------------------------------------
# MemAvailable the launcher demands before it will load (GiB). 0 disables.
MIN_FREE_GIB=90

# --- container only ------------------------------------------------------
# Registry namespace for the prebuilt image (ghcr.io/<owner>/deepseek-v41-flash-spark).
# GHCR_OWNER=0xbakeer
# Optional Hugging Face token for scripts/download-model.sh. The repo is public;
# a token only raises rate limits. Keep it in .env, never in env.example.
# HF_TOKEN=

# --- prefill / expert streaming knobs -----------------------------------
# These are read straight from the environment by the engine (not by start.sh),
# so `DSV41_PREFILL_CHUNK=512 ./start.sh` works. The defaults are what the
# measured numbers in NOTES.md "Speed work" were taken with.
#
# Prefill chunk length. A prefill chunk touches ~370 of the 384 experts of every
# layer whatever its length, so the NVMe traffic of a prompt is roughly
# chunks x layers x 7 GB: quadrupling the chunk quarters it. Costs activation
# memory (~2.7 GB peak at 2048).
# DSV41_PREFILL_CHUNK=2048
# Window ring slots per layer; must stay above window_size + DSV41_PREFILL_CHUNK.
# DSV41_RING=4096
# Decoder SWA Bounded Replay (tech report 3.2.2): prefill runs layers 0..20 over
# the whole prompt and layers 21..39 over the last 128 tokens only. 0 = run all
# 40 layers over the prompt like the reference does (exact, ~3x slower TTFT on a
# 1.8k-token prompt).
# DSV41_SWA_REPLAY=1
# Expert reader: one task per expert on DSV41_IO_THREADS workers, each expert's
# two file runs cut into DSV41_READ_CHUNK_MB aligned pieces issued on
# DSV41_READ_THREADS workers (0 = do not split).
# DSV41_IO_THREADS=12
# DSV41_READ_THREADS=24
# DSV41_READ_CHUNK_MB=4
# Which slice of the traced corpus ranks the warm-start hot set: mixed | coding | general.
# DSV41_HOT_PROFILE=mixed
# Dense (non-routed-expert) projections re-quantized from the checkpoint's fp8
# (e4m3 + UE8M0 32x32 block scales) to fp4 (E2M1 codes + one UE8M0 scale per 32 K
# weights of a row, the routed experts' format) at load time, which is 0.531x the
# bytes: off | shared | attn | wo_a | any comma combination ("all" = all three).
# "shared" is the shared-expert FFN w1/w2/w3, "attn" is wq_a/wq_b/wkv/wo_b, "wo_a"
# is the [8, 1024, 4096] attention output LoRA on the grouped kernel. The indexer
# wq_b, the engram wkv and mtp.0.main_proj always stay fp8.
# Measured 2026-09-11 (RESULTS.md 3.2/3.3): "attn" is 19.1 -> 20.9 tok/s at +0.002 (code) /
# -0.035 (prose) nats held-out; "wo_a" adds 630 MB/step less to read; "shared" costs
# +0.015 / +0.065 nats and is left in fp8. Code default: off.
DSV41_DENSE_FP4=attn,wo_a
# With a dense fp4 group enabled: run the fp4 kernel at prefill M too (kernel,
# default) or dequantize transiently and use cuBLAS (dequant), as the fp8 path does.
# DSV41_FP4_DENSE_PREFILL=kernel
# Activation dtype handed to the tensor cores by the dense fp4 kernel: 1 = fp16
# (what the routed-expert kernel does), 0 = bf16 (wider exponent range).
# DSV41_FP4_DENSE_F16=1

# --- the LM head's stored format. `head.weight` is [129280, 5120] and is read in full on every
# decode step, twice (the verify step and the DSpark draft). bf16 (the checkpoint's dtype, the
# default) is 1.324 GB per read; fp8 is e4m3 + one UE8M0 scale per 32x32 block, 0.663 GB; fp4 is
# E2M1 + one scale per 32 K weights of a row, 0.352 GB. Quantized once on the GPU at load.
# See NOTES.md 2026-09-11 for the measured loss and decode numbers behind the shipped value.
DSV41_HEAD_FMT=fp8
# Above decode-sized M a quantized head dequantizes 16,384 vocabulary rows at a time and hands each
# block to cuBLAS (blocked, the default); `kernel` runs the decode kernel at every M instead.
# DSV41_HEAD_PREFILL=blocked

# --- how many routed experts the router activates per token. The checkpoint stores 6 of 384
# (`n_activated_experts`), plus the layer's shared expert, which this switch does not touch. A
# smaller k keeps the highest gate logits, renormalizes the gate weights over the survivors exactly
# as the router already normalizes the six, and so touches fewer DISTINCT experts per verify block
# -- which is what sets the expert bytes a decode step reads. Measured 2026-09-11 (NOTES.md): k=5 is
# 0.84x the expert bytes and 8 ms off a 115 ms step, at +0.025 nats on held-out prose, which is
# above the +0.015 budget; k=4 is worse on both corpora. Unset = the checkpoint's 6.
# DSV41_TOPK=6
# The DSpark drafter's own router (top-3 of 128 per MTP block) is separate and is not affected.

# --- the DSpark verify block: one accepted token plus DSV41_BLOCK drafted ones. The checkpoint's
# DSpark head was trained at `dspark_block_size` = 5, which stays the default. Must be odd (the
# verify block, block + 1, has to be even: the ratio-2 key compressor groups the block's positions
# in pairs around one pending slot). A larger block amortizes the same 40 layers of routed-expert
# reads over more candidate tokens, but drafts further outside the head's trained horizon.
# DSV41_BLOCK=5

# --- pruned all-resident mode (v0.2.0-wip; RESULTS.md 2.3/2.4). Leave empty for the full model with
# expert streaming (3-4 tok/s on a 128 GB box). PRUNE_KEEP=0.31 with the values below gives ~13 tok/s
# at +0.07 (code) / +0.19 (prose) nats teacher-forced loss vs the full model.
PRUNE_KEEP=0.44
# How the kept set is chosen: uniform (top-N per layer) or global (one cross-layer ranking under
# the same total budget; see RESULTS.md). Default uniform.
PRUNE_SELECT=
# v0.3.0-wip (RESULTS.md v0.3.0-wip): PRUNE_KEEP=0.40 with EXPERT_FORMAT=cb3 (below) is all-resident in
# 90.5 GB and measured 19.0 tok/s at -0.03/-0.17 nats vs the 0.31/fp4 row above; warm start 183 s.
TRANSIENT_SLOTS=
KEEP_FREE_GB=
# Routed-expert arena format: empty/fp4 = the checkpoint's packed FP4 (18.80 MB per expert),
# cb3 = the 3-bit per-row codebook format (14.45 MB per expert, 0.769x), packed on the GPU at warm
# start. The same ARENA_GB then holds ~31 % more experts -- 90.5 GB is 4,813 FP4 slots or 6,260 CB3
# slots, so PRUNE_KEEP=0.40 (6,160 experts, 89.0 GB) is all-resident in CB3 but not in FP4.
# Warm start is slower for it (the packing is GPU work; see NOTES.md 2026-09-11).
EXPERT_FORMAT=cb3

# --- v0.4.0-wip shipped defaults (RESULTS.md v0.4.0-wip). The keep-set must be ranked on a trace
# that contains the workloads you serve: the original corpus had no markup in it and every pruned
# configuration then failed to write an HTML file.
# PRUNE_KEEP=0.44
# EXPERT_FORMAT=cb3
# ARENA_GB=98
# TRANSIENT_SLOTS=8
# KEEP_FREE_GB=6
# TRACE_STATS=results/trace-union/stats/coverage.json
# DSV41_DENSE_FP4=attn,wo_a
# DSV41_HEAD_FMT=fp8
# DSV41_FUSED_ATTN=0
